# OpenAI API anahtarını .env dosyasına kopyala. Gerçek anahtarı Git'e ekleme.
OPENAI_API_KEY=sk-proj-...

# Hesabında erişebildiğin farklı bir model varsa değiştirebilirsin.
OPENAI_MODEL=gpt-6-astra

# Supabase Dashboard > Project Settings > API bölümünden alınır.
# Service role anahtarını yalnızca sunucudaki .env dosyasında tut; tarayıcıya veya Git'e ekleme.
SUPABASE_URL=https://proje-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# Aynı Supabase projesinde farklı demo çalışma alanları kullanmak istersen değiştir.
XHABITAT_WORKSPACE_ID=xhabitat-demo
